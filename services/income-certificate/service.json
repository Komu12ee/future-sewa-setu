        {
          "id": "occupation",
          "selector": "#occupation",
          "label": { "hi": "व्यवसाय या सेवा" },
          "ask": { "hi": "आपका व्यवसाय या सेवा क्या है?" },
          "type": "text",
          "parser": "text",
          "required": true
        },
        {
          "id": "reasonDescription",
          "selector": "#reasonDescription",
          "label": { "hi": "आवेदन का कारण" },
          "ask": { "hi": "आय प्रमाण पत्र किस कारण से चाहिए?" },
