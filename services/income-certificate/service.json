          "type": "text",
          "parser": "name",
          "required": true,
          "prefillFrom": "profile.name",
          "confirm": true
        },
        {
          "id": "beneficiaryName",
          "selector": "#beneficiaryName",
          "label": { "hi": "हितग्राही का नाम" },
